# OS / editor cruft
.DS_Store
.vscode/
.idea/

# C++ build outputs (regenerable)
cpp/_obj/
cpp/_exe/
build/
*.dSYM/
*.o
*.d

# Xcode user state (the project itself is versioned)
cpp/*.xcodeproj/xcuserdata/
cpp/*.xcodeproj/project.xcworkspace/xcuserdata/

# Python packaging / build
__pycache__/
*.py[cod]
*.egg-info/
python/build/
python/dist/
python/wheelhouse/
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Golden gate generated reference (regenerated by generate_reference.R)
_golden/reference/

# R build artifacts / session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata/
*.rds
*.Rcheck/
R/src/*.o
R/src/*.so
